# ==============================================================================
# Azure Container Apps Platform — Environment Configuration
# ==============================================================================

# Core Azure Infrastructure
AZURE_SUBSCRIPTION_ID="00000000-0000-0000-0000-000000000000"
AZURE_TENANT_ID="00000000-0000-0000-0000-000000000000"
AZURE_REGION="eastus" # or westeurope, uaenorth, etc.
AZURE_RESOURCE_GROUP="rg-platform-apps"
AZURE_CONTAINER_APP_ENV="cae-platform-apps"
AZURE_ACR_NAME="crplatformapps"

# Persistent Storage (Azure Files CIFS)
AZURE_STORAGE_ACCOUNT="stplatformdata"
AZURE_STORAGE_RG="rg-platform-storage"

# DNS & Managed TLS
AZURE_DNS_ZONE="internal.example.com"
AZURE_DNS_RG="rg-platform-network"
ACA_CUSTOM_DOMAIN_VERIFICATION_ID="" # Retrieve via: az containerapp env show ... --query properties.customDomainConfiguration.customDomainVerificationId -o tsv

# Workload Identity / CI/CD (GitHub Actions)
AZURE_CLIENT_ID="00000000-0000-0000-0000-000000000000"
